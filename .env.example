# No credentials needed for demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional; not used by this frontend. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Your own licensed/self-hosted GraphHopper instance; no public demo server.
GRAPHHOPPER_URL=
GRAPHHOPPER_API_KEY=
# Optional licensed/self-hosted Photon endpoint (no key needed for local index).
PHOTON_URL=
# Optional approved raster tile template. Default OSM standard tiles, local evaluation only.
NEXT_PUBLIC_MAP_TILE_URL=
