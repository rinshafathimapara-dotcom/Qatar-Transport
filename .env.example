# No credentials needed for demo mode.
# Use the project root URL (without /rest/v1/).
NEXT_PUBLIC_SUPABASE_URL=
# This name accepts a modern sb_publishable_... key or a legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional; not used by this frontend. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Walking defaults to the bundled Doha OSM network; no routing key needed.
# Optional licensed/self-hosted GraphHopper override; no public demo server.
GRAPHHOPPER_URL=
GRAPHHOPPER_API_KEY=
# Optional licensed/self-hosted Photon endpoint (no key needed for local index).
PHOTON_URL=
# Default street map: OpenFreeMap. No signup or key is required.
# Optional override only: browser key from https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_MAPS_KEY=
# Optional alternative: your authorized raster template with {z}/{x}/{y}.
# Leave these blank for OpenFreeMap or CARTO. Custom provider credit is mandatory.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Optional licensed/self-hosted DRIVING router. Kept separate from walking.
# Fares remain unavailable for taxis until a driving provider returns a route.
DRIVING_GRAPHHOPPER_URL=
DRIVING_GRAPHHOPPER_API_KEY=
DRIVING_GRAPHHOPPER_PROFILE=car
