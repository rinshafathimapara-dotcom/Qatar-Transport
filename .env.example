# No credentials needed for demo mode.
# Use the project root URL (without /rest/v1/).
NEXT_PUBLIC_SUPABASE_URL=
# This name accepts a modern sb_publishable_... key or a legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional; not used by this frontend. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Your own licensed/self-hosted GraphHopper instance; no public demo server.
GRAPHHOPPER_URL=
GRAPHHOPPER_API_KEY=
# Optional licensed/self-hosted Photon endpoint (no key needed for local index).
PHOTON_URL=
# Browser basemap key: https://carto.com/basemaps/apikey/
# No direct OSM tile-server fallback. Supabase data works independently.
NEXT_PUBLIC_CARTO_MAPS_KEY=
# Optional alternative: your authorized raster template with {z}/{x}/{y}.
# Leave these blank when using CARTO. Custom provider credit is mandatory.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
